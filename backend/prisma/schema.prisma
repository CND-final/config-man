generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConfigValueType {
  string
  number
  boolean
  json
}

enum ChangeRequestStatus {
  pending
  approved
  rejected
}

model Project {
  id            String               @id @default(uuid())
  name          String               @unique
  description   String?
  repoUrl       String?
  ownerName     String
  defaultFormat String               @default("yaml")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  environments  ProjectEnvironment[]
  configEntries ConfigEntry[]
  auditLogs     AuditLog[]
  changeRequests ChangeRequest[]

  @@map("projects")
}

model ChangeRequest {
  id          String              @id @default(uuid())
  projectId   String
  environment String
  configKey   String?
  requester   String
  reviewer    String?
  status      ChangeRequestStatus @default(pending)
  reason      String
  comment     String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, environment, status])
  @@index([configKey])
  @@map("change_requests")
}

model ProjectEnvironment {
  id        String   @id @default(uuid())
  projectId String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId, sortOrder])
  @@map("project_environments")
}

model ConfigEntry {
  id          String          @id @default(uuid())
  projectId   String
  environment String
  key         String
  value       String
  valueType   ConfigValueType @default(string)
  isSensitive Boolean         @default(false)
  updatedBy   String          @default("seed-admin")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions    ConfigVersion[]

  @@unique([projectId, environment, key])
  @@index([projectId, environment])
  @@map("config_entries")
}

model ConfigVersion {
  id           String      @id @default(uuid())
  configId     String
  oldValue     String?
  newValue     String?
  changedBy    String
  changeReason String?
  createdAt    DateTime    @default(now())

  config       ConfigEntry @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId, createdAt])
  @@map("config_versions")
}

model AuditLog {
  id           String   @id @default(uuid())
  actor        String
  action       String
  resourceType String
  resourceId   String?
  projectId    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}
